# Quantum Cyber Threat Detection - Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# TinyFish API key for Q-Intel research integration
# Get one at: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Resend API key for email report delivery
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=

# Sender email for reports (must be a verified domain in Resend)
# Format: "Display Name <email@yourdomain.com>"
REPORT_FROM_EMAIL=QCTD Reports <noreply@example.com>

# NOTE ON SENDING TO ARBITRARY RECIPIENTS:
# With the shared onboarding@resend.dev sender, Resend only delivers to the
# account owner's own email address and returns HTTP 403 for anyone else.
# Fix by verifying your own domain at https://resend.com/domains and setting
# REPORT_FROM_EMAIL to an address on it (no further config needed).
#
# ALTERNATIVE -- SMTP fallback (no domain required):
# If you have no domain, configure the block below instead. Uses a real
# authenticated mailbox as the sending identity, so it is not spoofing.
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASSWORD.
# Leave RESEND_API_KEY empty so the SMTP transport is selected.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_USE_TLS=1
