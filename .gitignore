# Runtime data
# Demo session database written by server.py. Regenerated on every run,
# so it should never be committed.
*.db
*.sqlite3

# Debug and log files
*.log
debug_*.txt

# 123 MB project archive; may embed .env or the SQLite database. Keep it
# out of version control -- regenerate with 7-Zip when sharing.
kcc.7z
*.7z
